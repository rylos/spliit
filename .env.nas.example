# NAS Deploy Configuration
# Copia questo file in .env.nas (opzionale: i default vanno già bene)

# SSH Configuration (sudo sul NAS è NOPASSWD)
NAS_HOST=home.ziliani.net
NAS_PORT=2222
NAS_USER=marco
STACK_DIR=/volume1/docker/dockhand/stacks/NAS/spliit

# Password dello stack: si impostano direttamente nel compose di Dockhand
# POSTGRES_PASSWORD=your_db_password_here
# AUTH_USER=your_username_here
# AUTH_PASSWORD=your_auth_password_here
